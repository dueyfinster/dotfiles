#!/bin/sh
input=$(cat)
buf=$(printf "%s" "$input" | base64 | tr -d "\n")

# OSC 52 via tmux client TTYs (works over SSH)
if [ -n "$TMUX" ] || tmux list-clients >/dev/null 2>&1; then
  for tty in $(tmux list-clients -F "#{client_tty}"); do
    printf "\033]52;c;%s\a" "$buf" > "$tty"
  done
fi

# Native clipboard as fallback
case "$(uname -s)" in
  Darwin)
    printf "%s" "$input" | pbcopy 2>/dev/null
    ;;
  Linux)
    if [ -n "$WAYLAND_DISPLAY" ]; then
      printf "%s" "$input" | wl-copy 2>/dev/null
    elif [ -n "$DISPLAY" ]; then
      printf "%s" "$input" | xclip -in -selection clipboard 2>/dev/null
    fi
    ;;
  *) # WSL
    if command -v clip.exe >/dev/null 2>&1; then
      printf "%s" "$input" | clip.exe 2>/dev/null
    fi
    ;;
esac
